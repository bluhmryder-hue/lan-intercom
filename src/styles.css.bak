:root {
  color-scheme: dark;
  --bg: #090909;
  --panel: rgba(20, 20, 20, 0.92);
  --panel-soft: rgba(255, 255, 255, 0.04);
  --line: rgba(255, 255, 255, 0.12);
  --text: #f4f1ea;
  --muted: #b5b0a6;
  --accent: #d6a24a;
  --accent-2: #76d3ff;
  --danger: #ff6b6b;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(214, 162, 74, 0.16), transparent 32%),
    radial-gradient(circle at top right, rgba(118, 211, 255, 0.15), transparent 28%),
    linear-gradient(180deg, #111 0%, var(--bg) 100%);
}

button,
input,
select {
  font: inherit;
}

button {
  border: 0;
  border-radius: 999px;
  padding: 0.85rem 1.2rem;
  background: var(--accent);
  color: #101010;
  font-weight: 700;
  cursor: pointer;
}

button.ghost {
  background: transparent;
  border: 1px solid var(--line);
  color: var(--text);
}

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

input {
  width: 100%;
  border-radius: 0.9rem;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
  padding: 0.85rem 0.95rem;
}

select {
  width: 100%;
  border-radius: 0.9rem;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
  padding: 0.85rem 0.95rem;
}

#root {
  min-height: 100vh;
}

.app-shell {
  width: min(1200px, calc(100% - 2rem));
  margin: 0 auto;
  padding: 2rem 0 3rem;
}

.hero,
.controls,
.feeds,
.sidebar {
  margin-top: 1rem;
}

.hero {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 1rem;
  align-items: stretch;
}

.hero h1 {
  margin: 0.3rem 0 0.75rem;
  font-size: clamp(2.4rem, 5vw, 4.8rem);
  line-height: 0.95;
  letter-spacing: -0.04em;
  max-width: 11ch;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.25em;
  color: var(--accent-2);
  font-size: 0.76rem;
}

.lede {
  margin: 0;
  max-width: 62ch;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.6;
}

.status-card,
.controls,
.feed-card,
.peer-list,
.hint,
.error-banner {
  border: 1px solid var(--line);
  border-radius: 1.25rem;
  background: var(--panel);
  backdrop-filter: blur(12px);
}

.status-card {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1rem;
}

.status-pill {
  align-self: flex-start;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
}

.status-pill.live {
  background: rgba(118, 211, 255, 0.15);
  color: var(--accent-2);
}

.status-pill.idle {
  background: rgba(255, 255, 255, 0.08);
  color: var(--muted);
}

.status-meta {
  display: grid;
  gap: 0.45rem;
  color: var(--muted);
  font-size: 0.92rem;
}

.presence-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  width: fit-content;
  padding: 0.55rem 0.8rem;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--panel-soft);
  color: var(--text);
  font-size: 0.92rem;
}

.presence-chip.live {
  border-color: rgba(118, 211, 255, 0.35);
}

.presence-chip.connecting {
  border-color: rgba(214, 162, 74, 0.35);
}

.presence-chip.idle {
  border-color: rgba(255, 255, 255, 0.14);
}

.presence-dot,
.peer-dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 50%;
  display: inline-block;
  background: var(--muted);
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.05);
}

.presence-chip.live .presence-dot,
.peer-dot.connected {
  background: #5ce1ff;
}

.presence-chip.connecting .presence-dot,
.peer-dot.connecting {
  background: #d6a24a;
}

.presence-chip.idle .presence-dot,
.peer-dot.disconnected {
  background: #7d7a74;
}

.controls {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 0.9rem;
  padding: 1rem;
  align-items: end;
}

.controls label {
  display: grid;
  gap: 0.45rem;
  color: var(--muted);
  font-size: 0.9rem;
}

.control-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.error-banner,
.hint {
  padding: 1rem 1.1rem;
}

.error-banner {
  margin-top: 1rem;
  color: #ffd3d3;
  border-color: rgba(255, 107, 107, 0.4);
  background: rgba(255, 107, 107, 0.08);
}

.feeds {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 1rem;
}

.feed-card {
  padding: 1rem;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: 1rem;
}

.card-head h2,
.peer-list h2 {
  margin: 0;
  font-size: 1.05rem;
}

.card-head span,
.peer-list .muted {
  color: var(--muted);
}

.peer-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

.video-feed {
  display: grid;
  gap: 0.6rem;
}

.video-shell {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-radius: 1rem;
  border: 1px solid var(--line);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(0, 0, 0, 0.2));
}

.video-shell video,
.empty-video {
  width: 100%;
  height: 100%;
}

.video-shell video {
  object-fit: cover;
  display: block;
}

.empty-video {
  display: grid;
  place-items: center;
  color: var(--muted);
}

.video-caption {
  display: flex;
  justify-content: space-between;
  gap: 0.75rem;
  font-size: 0.95rem;
}

.video-caption span {
  color: var(--accent-2);
}

.empty-feed {
  min-height: 180px;
  border-radius: 1rem;
  border: 1px dashed var(--line);
  display: grid;
  place-items: center;
  text-align: center;
  padding: 1.5rem;
  color: var(--muted);
}

.peer-list {
  margin-top: 1rem;
  padding: 1rem;
}

.peer-list ul {
  list-style: none;
  margin: 0.75rem 0 0;
  padding: 0;
  display: grid;
  gap: 0.6rem;
}

.peer-list li {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.75rem 0.8rem;
  border-radius: 0.9rem;
  background: var(--panel-soft);
}

.peer-name {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
}

.peer-list em {
  color: var(--accent-2);
  font-style: normal;
  text-transform: lowercase;
}

.sidebar {
  display: grid;
  gap: 1rem;
}

.settings-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  margin-top: 1rem;
}

.setting-row {
  display: grid;
  gap: 0.45rem;
  margin-top: 0.9rem;
  color: var(--muted);
  font-size: 0.9rem;
}

.setting-toggle {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  margin-top: 0.8rem;
  color: var(--text);
}

.setting-toggle input {
  width: 1rem;
  height: 1rem;
  accent-color: var(--accent);
}

.hint {
  color: var(--muted);
  line-height: 1.5;
}

@media (max-width: 900px) {
  .hero,
  .feeds,
  .controls {
    grid-template-columns: 1fr;
  }
}
